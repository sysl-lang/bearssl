module sh.sysl.bearssl
@tests
@requires(heap, os)

import sysl.encoding.hex_string

// ECDSA against RFC 6979's own vectors (Appendix A.2.5 for P-256, A.2.6 for P-384). BearSSL derives
// the nonce as RFC 6979 does, so a signature is fully determined by the key and the message and must
// equal the RFC's `r` and `s` byte for byte. The public key derived from the private one must equal
// the RFC's `Ux`, `Uy`.

val P256_X: string = "c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721"
val P256_U: string = "0460fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb67903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299"
val P384_X: string = "6b9d3dad2e1b8c1c05b19875b6659f4de23c3b667bf297ba9aa47740787137d896d5724e4c70a825f872c9ea60d2edf5"
val P384_U: string = "04ec3a4e415b4e19a4568618029f427fa5da9a8bc4ae92e02e06aae5286b300c64def8f0ea9055866064a254515480bc138015d9b72d7d57244ea8ef9ac0c621896708a59367f9dfb9f54ca84b3f1c9db1288b231c3ae0d4fe7344fd2533264720"

signed_hex(key: *EcPrivateKey, hash: Hash, message: string) -> string
    var h: [64]u8 = [0; 64]
    val n = hash_of(hash, message.bytes, h[..]).unwrap()
    var sig: [132]u8 = [0; 132]
    val m = key.sign(hash, h[0..<n], sig[..]).unwrap()
    hex_string(sig[0..<m])

@test("P-256: the public key and both SHA-256 signatures match RFC 6979 A.2.5")
p256_rfc6979()
    var key = ec_private_key(Curve.P256, unhex(P256_X)).unwrap()
    var pk = key.public_key()
    assert_eq(hex_string(pk.point()), P256_U)
    assert_eq(signed_hex(&key, Hash.Sha256, "sample"),
              "efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8")
    assert_eq(signed_hex(&key, Hash.Sha256, "test"),
              "f1abb023518351cd71d881567b1ea663ed3efcf6c5132b354f28d3b0b7d38367019f4113742a2b14bd25926b49c649155f267e60d3814b4c0cc84250e46f0083")

@test("P-384: the public key and both SHA-384 signatures match RFC 6979 A.2.6")
p384_rfc6979()
    var key = ec_private_key(Curve.P384, unhex(P384_X)).unwrap()
    var pk = key.public_key()
    assert_eq(hex_string(pk.point()), P384_U)
    assert_eq(signed_hex(&key, Hash.Sha384, "sample"),
              "94edbb92a5ecb8aad4736e56c691916b3f88140666ce9fa73d64c4ea95ad133c81a648152e44acf96e36dd1e80fabe4699ef4aeb15f178cea1fe40db2603138f130e740a19624526203b6351d0a3a94fa329c145786e679e7b82c71a38628ac8")
    assert_eq(signed_hex(&key, Hash.Sha384, "test"),
              "8203b63d3c853e8d77227fb377bcf7b7b772e97892a80f36ab775d509d7a5feb0542a7f0812998da8f1dd3ca3cf023dbddd0760448d42d8a43af45af836fce4de8be06b485e9b61b827c2f13173923e06a739f040649a667bf3b828246baa5a5")

@test("the RFC's signature verifies, and a signature or hash changed by one bit does not")
ecdsa_verify()
    var pk = ec_public_key(Curve.P256, unhex(P256_U)).unwrap()
    var h: [32]u8 = [0; 32]
    hash_of(Hash.Sha256, "sample".bytes, h[..]).unwrap()
    var sig = unhex("efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8")
    assert(pk.verify(h[..], sig))
    sig[63] ^= 1
    assert(!pk.verify(h[..], sig))
    sig[63] ^= 1
    h[0] ^= 1
    assert(!pk.verify(h[..], sig))

@test("a DER signature verifies as DER, and a generated key signs and verifies")
ecdsa_der_and_generated()
    var rng = random(unhex(P256_X)).unwrap()
    var key = generate_ec_key(&rng, Curve.P384).unwrap()
    assert_eq(key.scalar().len, 48)
    var pk = key.public_key()
    var h: [48]u8 = [0; 48]
    hash_of(Hash.Sha384, "message".bytes, h[..]).unwrap()
    var der: [105]u8 = [0; 105]
    val n = key.sign_der(Hash.Sha384, h[..], der[..]).unwrap()
    assert_eq(der[0], 0x30)
    assert(pk.verify_der(h[..], der[0..<n]))
    assert(!pk.verify(h[..], der[0..<n]))

@test("ECDSA refuses a hash of the wrong length, a short signature buffer and a scalar of the wrong length")
ecdsa_refusals()
    var key = ec_private_key(Curve.P256, unhex(P256_X)).unwrap()
    var sig: [64]u8 = [0; 64]
    var h: [32]u8 = [0; 32]
    assert_eq(key.sign(Hash.Sha384, h[..], sig[..]).unwrap_err().code, BAD_LENGTH)
    assert_eq(key.sign(Hash.Sha256, h[..], sig[0..<63]).unwrap_err().code, TOO_SMALL)
    assert_eq(ec_private_key(Curve.P384, unhex(P256_X)).unwrap_err().code, BAD_LENGTH)
    assert_eq(ec_public_key(Curve.P384, unhex(P256_U)).unwrap_err().code, BAD_LENGTH)
