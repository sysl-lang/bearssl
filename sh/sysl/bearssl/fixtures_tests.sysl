// The modulus of `RSA_KEY`, as `openssl rsa -modulus` prints it; the exponent is 65537.
val RSA_MODULUS: string = ""

// `openssl dgst -sha256 -sign RSA_KEY` and `-sha384` over "sample": PKCS#1 v1.5, which is
// deterministic, so BearSSL's signature with the same key must be these bytes.
val RSA_SIG_SHA256: string = ""
val RSA_SIG_SHA384: string = ""

// `openssl dgst -sha256 -sign EC_KEY` over "sample": ECDSA in DER, with OpenSSL's own random nonce.
val EC_SIG_DER: string = "3046022100b8e8f6b03affe2f466859c9a6400f208cdbe796e820caeaca581d0c8fc44c48d022100f0215e6e4cb6d77ef4b493ebaa252201f076255c1f73165b4fa343dfb21e2ad4"
