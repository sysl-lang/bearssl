module sh.sysl.bearssl
@tests
@requires(heap, os)

import sysl.fs.{exists, make_temp_dir, read_text, remove_dir_all, write_text}
import sysl.net.{Socket, resolve, socket}
import sysl.process.{Spawned, Stdio, capture, spawn}
import sysl.text.parse_int
import sysl.time.{millis, sleep}

// BearSSL against an independent implementation over real TCP sockets: the host's `openssl` (OpenSSL 3
// from Homebrew where it is installed, otherwise the system's LibreSSL). Certificates are made fresh
// by `openssl req` in each test. The BearSSL client talks to `openssl s_server -rev`, which answers
// each line reversed; `openssl s_client` talks to the BearSSL server, which answers each line with
// "echo: " in front. Every host process is started by recorded PID and killed at the end of its test.

openssl() -> string =
    if exists("/opt/homebrew/opt/openssl@3/bin/openssl") then "/opt/homebrew/opt/openssl@3/bin/openssl" else "/usr/bin/openssl"

// Run `openssl` with `args` and fail the test if it fails.
run_openssl(args: []const string)
    val r = capture(openssl(), args, stderr = true).unwrap()
    assert(r.status.ok(), s"openssl ${args[0]} failed: ${r.text}")

// A self-signed certificate for `localhost` and its key, at `<dir>/<name>.crt` and `.key`.
make_cert(dir: string, name: string, kind: string)
    val key = s"${dir}/${name}.key"
    val crt = s"${dir}/${name}.crt"
    if kind == "rsa"
        run_openssl(["genpkey", "-algorithm", "RSA", "-pkeyopt", "rsa_keygen_bits:2048", "-out", key])
    else
        run_openssl(["ecparam", "-name", if kind == "p384" then "secp384r1" else "prime256v1", "-genkey", "-noout", "-out", key])
    if kind == "expired"
        run_openssl(["req", "-x509", "-key", key, "-subj", "/CN=localhost", "-addext", "subjectAltName=DNS:localhost",
                     "-not_before", "20180101000000Z", "-not_after", "20200101000000Z", "-sha256", "-out", crt])
    else
        run_openssl(["req", "-x509", "-key", key, "-subj", "/CN=localhost", "-addext", "subjectAltName=DNS:localhost",
                     "-days", "2", "-sha256", "-out", crt])

// How long a wait for a started process may take: 60 s. A loaded machine (the org census runs dozens of
// test processes at once) has been seen to need over 10 s to start `openssl s_server`.
val wait_steps = 600

// The port `openssl s_server -accept 127.0.0.1:0` bound, which it reports as `ACCEPT 127.0.0.1:<port>` on
// stdout once it is listening. The OS chose the port, so nothing else can have taken it.
server_port(dir: string) -> int
    for _ in 0..<wait_steps
        if exists(s"${dir}/s_server.out")
            val text = read_text(s"${dir}/s_server.out").unwrap()
            text.index_of("ACCEPT ") match
                Some(at) ->
                    val rest = text[at..]
                    rest.index_of("\n") match
                        Some(nl) ->
                            val line = rest[0..<nl]
                            val colon = line.last_index_of(":").unwrap()
                            return parse_int(line[colon + 1..]).unwrap()
                        None -> ()
                None -> ()
        sleep(millis(100))
    panic("openssl s_server never reported the port it listens on")

// Connect to a server that may still be starting.
connect_to(port: int) -> Socket
    val addr = resolve("127.0.0.1", port).unwrap()[0]
    for _ in 0..<wait_steps
        var s = socket(addr).unwrap()
        if s.connect(addr).is_ok()
            s.read_timeout(30000).unwrap()
            return s
        s.close().unwrap()
        sleep(millis(100))
    panic(s"nothing came to listen on port ${port}")

// Write everything the engine has for the wire.
flush_out[T: Connection](tls: *T, sock: *Socket)
    var buf: [4096]u8 = [0; 4096]
    loop
        val n = tls.outgoing(buf[..])
        if n == 0 then break
        sock.send_all(buf[0..<n]).unwrap()

// Read once from the wire and hand all of it to the engine, draining between pieces. False at the end
// of the stream.
feed_in[T: Connection](tls: *T, sock: *Socket) -> bool
    var buf: [4096]u8 = [0; 4096]
    val n = sock.recv(buf[..]).unwrap()
    if n == 0 then return false
    var at = 0usize
    while at < n
        val k = tls.incoming(buf[at..<n])
        at += k
        flush_out(tls, sock)
        if k == 0 && !tls.wants_input() then break
    true

// Drive the handshake to its end over `sock`.
handshake_over[T: Connection](tls: *T, sock: *Socket) -> Result[unit, Error]
    loop
        flush_out(tls, sock)
        if tls.ready()? then return Ok(())
        if tls.wants_input() && !feed_in(tls, sock)
            tls.ready()?
            return fail(IO_FAILED)

// Send `text` and read until a newline arrives.
line_over[T: Connection](tls: *T, sock: *Socket, text: string) -> string
    assert_eq(tls.send(text.bytes).unwrap(), text.len)
    flush_out(tls, sock)
    read_line(tls, sock)

read_line[T: Connection](tls: *T, sock: *Socket) -> string
    var got: []u8 = [0; 512]
    var len = 0usize
    loop
        tls.receive(got[len..]).unwrap() match
            Data(n) ->
                len += n
                if len > 0 && got[len - 1] == 10 then return str_cast(got[0..<len])
            Wants ->
                flush_out(tls, sock)
                assert(feed_in(tls, sock), "the stream ended before a line arrived")
            Closed -> return str_cast(got[0..<len])

stop(p: &Spawned)
    var q = p
    q.kill(9).unwrap()
    q.wait()

// The BearSSL client against `openssl s_server` presenting `<name>.crt`, trusting `trusted.crt`.
// Answers the handshake's verdict, and on success the suite and the reversed line.
client_run(dir: string, name: string, trusted: string, offer: []const u16) -> Result[(u16, string), Error]
    val server = spawn(openssl(), ["s_server", "-accept", "127.0.0.1:0", "-cert", s"${dir}/${name}.crt", "-key",
                                   s"${dir}/${name}.key", "-tls1_2", "-rev", "-naccept", "1"],
                       stdout = Stdio.ToPath(s"${dir}/s_server.out"), stderr = Stdio.ToPath(s"${dir}/s_server.err")).unwrap()
    val port = server_port(dir)
    var sock = connect_to(port)
    var anchors: TrustAnchors[2, 4096] = trust_anchors()
    anchors.add_pem(read_text(s"${dir}/${trusted}.crt").unwrap().bytes).unwrap()
    var tls: Client[BUFSIZE_BIDI] = client()
    tls.init(&anchors)
    tls.seed("thirty-two bytes of seed, or rather a few more".bytes).unwrap()
    if offer.len > 0 then tls.suites(offer).unwrap()
    tls.start("localhost").unwrap()
    val outcome = handshake_over(&tls, &sock) match
        Ok(_) -> Ok((tls.suite(), line_over(&tls, &sock, "hello from bearssl\n")))
        Err(e) ->
            flush_out(&tls, &sock)
            Err(e)
    sock.close().unwrap()
    stop(server)
    outcome

@test("the BearSSL client and openssl s_server: ECDHE-ECDSA with a P-256 certificate, data both ways")
client_to_openssl_ec()
    val dir = make_temp_dir("bearssl-interop-").unwrap()
    make_cert(dir, "ec", "p256")
    // BearSSL's client lists ChaCha20-Poly1305 first (its AES is the constant-time software one), and
    // OpenSSL's server takes the client's preference.
    val (suite, line) = client_run(dir, "ec", "ec", []).unwrap()
    assert_eq(suite, ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256)
    assert_eq(line, "lssraeb morf olleh\n")
    val (s2, l2) = client_run(dir, "ec", "ec", [ECDHE_ECDSA_WITH_AES_128_GCM_SHA256]).unwrap()
    assert_eq(s2, ECDHE_ECDSA_WITH_AES_128_GCM_SHA256)
    assert_eq(l2, "lssraeb morf olleh\n")
    remove_dir_all(dir).unwrap()

@test("the BearSSL client and openssl s_server: ECDHE-RSA with an RSA-2048 certificate, both GCM widths")
client_to_openssl_rsa()
    val dir = make_temp_dir("bearssl-interop-").unwrap()
    make_cert(dir, "rsa", "rsa")
    val (suite, line) = client_run(dir, "rsa", "rsa", []).unwrap()
    assert_eq(suite, ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256)
    assert_eq(line, "lssraeb morf olleh\n")
    val (s2, l2) = client_run(dir, "rsa", "rsa", [ECDHE_RSA_WITH_AES_256_GCM_SHA384]).unwrap()
    assert_eq(s2, ECDHE_RSA_WITH_AES_256_GCM_SHA384)
    assert_eq(l2, "lssraeb morf olleh\n")
    val (s3, _) = client_run(dir, "rsa", "rsa", [ECDHE_RSA_WITH_AES_128_GCM_SHA256]).unwrap()
    assert_eq(s3, ECDHE_RSA_WITH_AES_128_GCM_SHA256)
    remove_dir_all(dir).unwrap()

@test("the BearSSL client refuses openssl s_server's certificate under the wrong anchor (X509_NOT_TRUSTED) and an expired one (X509_EXPIRED)")
client_refuses_openssl()
    val dir = make_temp_dir("bearssl-interop-").unwrap()
    make_cert(dir, "ec", "p256")
    make_cert(dir, "other", "p256")
    make_cert(dir, "expired", "expired")
    assert_eq(client_run(dir, "ec", "other", []).unwrap_err().code, X509_NOT_TRUSTED)
    assert_eq(client_run(dir, "expired", "expired", []).unwrap_err().code, X509_EXPIRED)
    remove_dir_all(dir).unwrap()

// The BearSSL server presenting `<name>.crt` to `openssl s_client` trusting `trusted.crt`. Answers the
// server's handshake verdict and suite, what s_client printed, and whether it exited cleanly.
server_run(dir: string, name: string, trusted: string, cipher: string) -> (Result[u16, Error], string, bool)
    val addr = resolve("127.0.0.1", 0).unwrap()[0]
    var listener = socket(addr).unwrap()
    listener.reuse_address().unwrap()
    listener.bind(addr).unwrap()
    listener.listen().unwrap()
    val port = listener.local().unwrap().port()
    write_text(s"${dir}/in.txt", "ping from openssl\n").unwrap()
    var args: []string = ["s_client", "-connect", s"127.0.0.1:${port}", "-CAfile", s"${dir}/${trusted}.crt",
                          "-verify_return_error", "-verify_hostname", "localhost", "-servername", "localhost",
                          "-tls1_2", "-quiet", "-cipher", if cipher == "" then "ECDHE" else cipher]
    val peer = spawn(openssl(), args, stdin = Stdio.FromPath(s"${dir}/in.txt"),
                     stdout = Stdio.ToPath(s"${dir}/s_client.out"), stderr = Stdio.ToPath(s"${dir}/s_client.err")).unwrap()
    val (conn, _) = listener.accept().unwrap()
    var sock = conn
    sock.read_timeout(10000).unwrap()
    var id: Identity[8192] = identity()
    id.add_pem(read_text(s"${dir}/${name}.crt").unwrap().bytes).unwrap()
    id.add_pem(read_text(s"${dir}/${name}.key").unwrap().bytes).unwrap()
    var tls: Server[BUFSIZE_BIDI] = server()
    tls.init(&id).unwrap()
    tls.seed("the server seeds itself with thirty-two bytes too".bytes).unwrap()
    tls.start().unwrap()
    val verdict = handshake_over(&tls, &sock) match
        Ok(_) ->
            val line = read_line(&tls, &sock)
            assert_eq(tls.send(s"echo: ${line}".bytes).unwrap(), line.len + 6)
            tls.close()
            flush_out(&tls, &sock)
            Ok(tls.suite())
        Err(e) -> Err(e)
    sock.close().unwrap()
    var p = peer
    var clean = false
    for _ in 0..<wait_steps
        p.try_wait().unwrap() match
            Some(st) ->
                clean = st.ok()
                break
            None -> sleep(millis(100))
    p.kill(9)
    p.wait()
    listener.close().unwrap()
    (verdict, read_text(s"${dir}/s_client.out").unwrap(), clean)

@test("openssl s_client and the BearSSL server: ECDHE-ECDSA, verified by s_client, data both ways")
openssl_to_server_ec()
    val dir = make_temp_dir("bearssl-interop-").unwrap()
    make_cert(dir, "ec", "p256")
    // OpenSSL's client lists AES-256-GCM first, and BearSSL's server takes the client's preference.
    val (verdict, printed, clean) = server_run(dir, "ec", "ec", "")
    assert_eq(verdict.unwrap(), ECDHE_ECDSA_WITH_AES_256_GCM_SHA384)
    assert_eq(printed, "echo: ping from openssl\n")
    assert(clean)
    val (v2, p2, c2) = server_run(dir, "ec", "ec", "ECDHE-ECDSA-CHACHA20-POLY1305")
    assert_eq(v2.unwrap(), ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256)
    assert_eq(p2, "echo: ping from openssl\n")
    assert(c2)
    remove_dir_all(dir).unwrap()

@test("openssl s_client and the BearSSL server: ECDHE-RSA with AES-256-GCM")
openssl_to_server_rsa()
    val dir = make_temp_dir("bearssl-interop-").unwrap()
    make_cert(dir, "rsa", "rsa")
    val (verdict, printed, clean) = server_run(dir, "rsa", "rsa", "ECDHE-RSA-AES256-GCM-SHA384")
    assert_eq(verdict.unwrap(), ECDHE_RSA_WITH_AES_256_GCM_SHA384)
    assert_eq(printed, "echo: ping from openssl\n")
    assert(clean)
    remove_dir_all(dir).unwrap()

@test("openssl s_client refuses the BearSSL server's certificate under the wrong CA, and the server hears it as an unknown_ca alert")
openssl_refuses_server()
    val dir = make_temp_dir("bearssl-interop-").unwrap()
    make_cert(dir, "ec", "p256")
    make_cert(dir, "other", "p256")
    val (verdict, printed, clean) = server_run(dir, "ec", "other", "")
    assert_eq(verdict.unwrap_err().code, RECV_FATAL_ALERT + 48)
    assert_eq(printed, "")
    assert(!clean)
    remove_dir_all(dir).unwrap()
